        {
          "name": "correctness",
          "grader": "exact-match",
          "expected": {
            "status": "completed"
          }
        },
        {
          "name": "trajectory",
          "grader": "trajectory-match",
          "trajectory": [
            {
              "tool": "country-info"
            },
            {
